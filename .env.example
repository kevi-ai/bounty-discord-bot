# ═══════════════════════════════════════════════════════════════
# AI Bounty Board Discord Bot - Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# REQUIRED: Discord Configuration
# ─────────────────────────────────────────────────────────────────

# Your Discord bot token (from Discord Developer Portal)
# Get it from: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=

# Your Discord application ID
# Get it from: https://discord.com/developers/applications → General Information
DISCORD_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Notification Settings
# ─────────────────────────────────────────────────────────────────

# Default channel ID for bounty notifications
# Right-click a channel in Discord → Copy ID (enable Developer Mode in settings)
NOTIFICATION_CHANNEL_ID=

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Filtering
# ─────────────────────────────────────────────────────────────────

# Only notify for bounties with these tags (comma-separated)
# Example: TAG_FILTER=coding,frontend,agents
# Leave empty to receive all bounties
TAG_FILTER=

# Minimum reward to notify (in USDC)
# Example: MIN_REWARD=10
MIN_REWARD=0

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Polling Configuration
# ─────────────────────────────────────────────────────────────────

# How often to check for bounty updates (milliseconds)
# Default: 60000 (1 minute)
# Minimum: 10000 (10 seconds) - don't go lower to avoid rate limits
POLL_INTERVAL=60000

# API timeout in milliseconds
API_TIMEOUT=10000

# Retry delay on API failure (milliseconds)
RETRY_DELAY=5000

# Maximum retries before logging warning
MAX_RETRIES=3

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: Feature Flags
# ─────────────────────────────────────────────────────────────────

# Enable/disable automatic notifications
ENABLE_NOTIFICATIONS=true

# Enable/disable slash commands
ENABLE_SLASH_COMMANDS=true

# Enable/disable the /claim command (security consideration)
ENABLE_CLAIM_COMMAND=true

# ─────────────────────────────────────────────────────────────────
# OPTIONAL: API Configuration (usually don't need to change)
# ─────────────────────────────────────────────────────────────────

# Bounty Board API URL
BOUNTY_API_URL=https://bounty.owockibot.xyz
